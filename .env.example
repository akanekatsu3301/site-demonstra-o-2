HOST=127.0.0.1
PORT=3000
DATABASE_PATH=data/prospect.sqlite
NOMINATIM_URL=https://nominatim.openstreetmap.org/search
OVERPASS_URL=https://overpass-api.de/api/interpreter
# Para uso compartilhado, inclua URL ou e-mail real do operador no User-Agent.
OSM_USER_AGENT=VORTEK-Prospect/1.0 (local interactive business research)
OSM_RESULT_LIMIT=100
# Obrigatório ao expor o servidor fora de loopback
APP_TOKEN=
SEARCHES_PER_MINUTE=6
# Opcional no build: domínio real com barra final para canonical e Open Graph.
# PUBLIC_SITE_URL=https://seu-dominio-real/
